# Required for Discord login
DiscordToken=

# Comma-separated Discord user IDs treated as bot owners
BotOwnerIds=

# Optional basics
DefaultLocale=en
APIHost=0.0.0.0
APIPort=3000
# Integrated web UI on the same Core HTTP origin/port as the API:
#   auto  — mount SPA only when apps/web/dist and the dashboard plugin are available
#   true  — require SPA assets + dashboard plugin or fail startup
#   false — API only; do not mount UI
# Invalid values fail startup (never silently remapped).
DashboardMode=auto
# Production UI is served from Core (APIPort). DashboardPort is development-only (Vite HMR).
# DashboardPort=5173
# Optional public URL of the Core API when reverse-proxied (same origin as the UI in production)
# ApiPublicUrl=https://bot.example.com
# Discord OAuth (authorization-code + PKCE) for the browser dashboard — server-side only
# DiscordOAuthClientId=
# DiscordOAuthClientSecret=
# Comma-separated exact redirect URIs pre-registered with Discord (must match callback)
# DashboardOAuthRedirectUris=
# Exact browser origins allowed for cookie-authenticated mutations (comma-separated)
# DashboardAllowedOrigins=https://bot.example.com
https://bot.example.com/api/dash/auth/oauth/callback
# Gateway master key for machine API bearer auth (never send to the browser)
# GatewayMasterKey=
LogLevel=info
NODE_ENV=production

# Required when using the token subsystem
# TokenMasterSecret=

# Database: JSON object of alias -> connection config.
# engine (optional when URI protocol is unambiguous) must be one of:
#   native-pg | native-sqlite | typeorm | redis | mongo | surrealdb
# Valid minimal single-host examples (uncomment exactly one Database= line):
#
# SQLite (local file; forbidden when CROSS_HOST=true):
# Database={"main":{"uri":"sqlite://./.data/zene.sqlite","engine":"native-sqlite"}}
#
# PostgreSQL:
# Database={"main":{"uri":"postgres://user:pass@127.0.0.1:5432/zene","engine":"native-pg","poolSize":10}}
#
# MongoDB:
# Database={"main":{"uri":"mongodb://127.0.0.1:27017/zene","engine":"mongo"}}
#
# Redis:
# Database={"main":{"uri":"redis://127.0.0.1:6379","engine":"redis"}}
#
# SurrealDB (remote ws/wss preferred for multi-host):
# Database={"main":{"uri":"ws://127.0.0.1:8000","engine":"surrealdb","namespace":"main","database":"main"}}
#
# SurrealDB embedded (single-host only; forbidden when CROSS_HOST=true):
# Database={"main":{"uri":"rocksdb://./.data/surreal/main","engine":"surrealdb","namespace":"main","database":"main"}}

# Optional local Surreal main when not using the lines above
# Database={"main":{"uri":"rocksdb://local","engine":"surrealdb","namespace":"main","database":"main"}}

# Integrity / plugins
# allowUnCertifiedPlugins=false
# PublicKey=
# PluginPublicKeys=

# Cross-Host (leave false for single-host)
# CROSS_HOST=false
# CROSS_HOST_CLUSTER_SECRET=
# CROSS_HOST_ROLE=
# CROSS_HOST_ORCHESTRATOR_URL=

# Updater
# AutoUpdater=true
# UpdaterDryRun=false
# UpdaterBackgroundApply=false

# Defaults / disable local engines
# DisableDefaultSqlite=false
# DisableDefaultSurrealDB=false