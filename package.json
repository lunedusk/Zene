{
  "name": "@lunedusk/zene",
  "version": "0.5.6",
  "description": "The most versatile modular discord framework for Node.js (discord.js) in TypeScript",
  "main": "./index.js",
  "type": "module",
  "imports": {
    "#core/*": "./core/*",
    "#plugins/*": "./plugins/*",
    "#scripts/*": "./scripts/*"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "clean": "rm -rf core plugins scripts database types index.js index.d.ts",
    "install-packages": "npm install --prefix packages/gateway-multiplex && npm run build --prefix packages/gateway-multiplex",
    "prepare-plugin-deps": "tsx src/scripts/installPluginDependencies.ts",
    "postinstall": "npm run install-packages",
    "compile": "npm run prepare-plugin-deps && tsc",
    "copy-assets": "tsx src/scripts/copyAssets.ts",
    "build": "npm run clean && npm run install-packages && npm run compile && npm run copy-assets",
    "slim-build": "npm run clean && npm run compile && npm run copy-assets",
    "start": "node --import ./core/dependency/index.mjs ./index.js",
    "pack": "node --import ./core/dependency/index.mjs ./scripts/manifestPacker.js",
    "dev": "npm run prepare-plugin-deps && tsx --import ./src/core/dependency/index.mts ./src/index.ts",
    "docs": "npm run rmdocs && typedoc",
    "rmdocs": "rm -rf docs",
    "lint": "eslint src --fix",
    "flush": "rm -rf core plugins configuration logs .data scripts index.js index.d.ts",
    "updater": "node --import ./core/dependency/index.mjs ./index.js --updater"
  },
  "dependencies": {
    "@lunedusk/gateway-multiplex": "file:packages/gateway-multiplex",
    "better-sqlite3": "^12.8.0",
    "cbor": "^10.0.12",
    "chokidar": "^5.0.0",
    "cors": "^2.8.6",
    "cron-parser": "^5.10.0",
    "discord.js": "^14.26.2",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "fast-json-patch": "^3.1.1",
    "fast-redact": "^3.5.0",
    "flatbuffers": "^25.9.23",
    "hash-wasm": "^4.12.0",
    "ioredis": "^5.11.1",
    "json5": "^2.2.3",
    "mongoose": "^9.9.5",
    "msgpackr": "^2.1.0",
    "murmurhash3js": "^3.0.1",
    "mysql2": "^3.24.3",
    "pg": "^8.20.0",
    "prom-client": "^15.1.3",
    "reflect-metadata": "^0.2.2",
    "surrealdb": "^2.0.8",
    "@surrealdb/node": "^3.0.3",
    "swagger-jsdoc": "^6.2.8",
    "typeorm": "^1.1.1",
    "winston": "^3.12.0",
    "winston-daily-rotate-file": "^5.0.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/archiver": "^8.0.0",
    "@types/better-sqlite3": "^9.6.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/fast-redact": "^3.0.4",
    "@types/murmurhash3js": "^3.0.3",
    "@types/node": "^26.4.1",
    "@types/nodemailer": "^8.0.0",
    "@types/pg": "^8.23.1",
    "@types/swagger-jsdoc": "^6.0.4",
    "archiver": "^8.0.0",
    "tsc-alias": "^1.9.4",
    "tsx": "^4.23.13",
    "typedoc": "^0.28.18",
    "typescript": "^6.0.3"
  },
  "overrides": {
    "glob": "^13.0.6"
  }
}
