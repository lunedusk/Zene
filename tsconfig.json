{
  "compilerOptions": {
    "target": "ES2022",
    "module": "Node16",
    "moduleResolution": "Node16",
    "rootDir": "./src",
    "outDir": "./",
    "paths": {
      "#core/*": ["./src/core/*"],
      "#plugins/*": ["./src/plugins/*"],
      "#scripts/*": ["./src/scripts/*"]
    },
    "types": ["node"],
    "strict": true,
    "esModuleInterop": true,
    "declaration": true,
    "emitDeclarationOnly": false,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.mts"
  ],
  "exclude": [
    "node_modules",
    "plugins/**/node_modules",
    ".data/**/node_modules"
  ]
}
