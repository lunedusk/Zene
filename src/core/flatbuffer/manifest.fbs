namespace Zene.System;

table FileEntry {
  path: string (key);
  hash: [ubyte];
  size: uint;
}

table IntegrityPayload {
  timestamp: ulong;
  algorithm: string;
  files: [FileEntry];
  ignore_hash: [string];
}

table NodeDependency {
  name: string (key);
  version: string;
}

// Field layout (additive only):
// 0-9 existing, 10 priority (Phase 1A),
// 11 signed_payload (Phase 2E JCS logical payload UTF-8),
// 12 metadata_version, 13 canonicalization_version
table ZeneManifest {
  id: string;
  name: string;
  version: string;
  description: string;
  author: string;
  dependencies: [string];
  zene_version: string;
  node_version: string;
  integrity: IntegrityPayload;
  node_dependencies: [NodeDependency];
  priority: int;
  signed_payload: string;
  metadata_version: int;
  canonicalization_version: int;
}

root_type ZeneManifest;
